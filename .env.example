# Environment Variables - Backend (Vercel Serverless API)
# Copy this file to .env and fill in your values

# Brapi API Key for fetching stock quotes
# Get it at: https://brapi.dev/
BRAPI_API_KEY=your_brapi_api_key

# Gemini API Key for processing bank statements (if still used)
# Get it at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key

# GitHub Token for triggering GitHub Actions (Historical Data)
# Needs 'repo' scope. Get it at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=Finance-Tracker
